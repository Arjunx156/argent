set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

default: check

# Run the app
dev:
    bun run NAME

# Format check, lint, types, tests
check:
    bun x biome check .
    bun x tsc --noEmit
    bun test

# Fix formatting and autofixable lint
fmt:
    bun x biome check --write .

test *args:
    bun test {{args}}
